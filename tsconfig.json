{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-me/types/**/*.ts",
    ".next-me/dev/types/**/*.ts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-e2e-nodemo/types/**/*.ts",
    ".next-e2e-nodemo/dev/types/**/*.ts",
    ".next-org/types/**/*.ts",
    ".next-org/dev/types/**/*.ts",
    ".next-oh/types/**/*.ts",
    ".next-oh/dev/types/**/*.ts",
    ".next-cal/types/**/*.ts",
    ".next-cal/dev/types/**/*.ts",
    ".next-home/types/**/*.ts",
    ".next-home/dev/types/**/*.ts",
    ".next-apply/types/**/*.ts",
    ".next-apply/dev/types/**/*.ts",
    ".next-org2/types/**/*.ts",
    ".next-org2/dev/types/**/*.ts",
    ".next-e2e-qa/types/**/*.ts",
    ".next-e2e-qa/dev/types/**/*.ts",
    ".next-lead/types/**/*.ts",
    ".next-lead/dev/types/**/*.ts",
    ".next-visual/types/**/*.ts",
    ".next-visual/dev/types/**/*.ts",
    ".next-copy/types/**/*.ts",
    ".next-copy/dev/types/**/*.ts",
    ".next-release/types/**/*.ts",
    ".next-release/dev/types/**/*.ts",
    ".next-audit-edge/types/**/*.ts",
    ".next-audit-edge/dev/types/**/*.ts",
    ".next-verify/types/**/*.ts",
    ".next-verify/dev/types/**/*.ts",
    ".next-audit-flows/types/**/*.ts",
    ".next-audit-flows/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next-*",
    ".data",
    "test-results",
    "playwright-report"
  ]
}
