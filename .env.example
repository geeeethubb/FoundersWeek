# Copy to .env.local for local development. Never commit real secrets.

# Public origin used for metadata, share links and emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (required for applications) ──────────────────────────────────────────
# Any standard Postgres. Tables are created automatically on first use. See README → Database setup.
#  A) Vercel → Storage → Neon (free): Vercel sets DATABASE_URL / POSTGRES_URL for you.
#  B) Reuse an existing Supabase project: its Transaction pooler URI + DATABASE_SCHEMA=founders_week
#       DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#       DATABASE_SCHEMA=founders_week
#  C) Local only (development / single machine): embedded Postgres in ./.data/pglite (not on Vercel)
DATABASE_URL=pglite:./.data/pglite
# DATABASE_SCHEMA=founders_week      # optional: keep tables in their own schema
# DATABASE_AUTO_MIGRATE=false        # optional: disable automatic table setup
DATABASE_POOL_MAX=3

# ── Secrets (required in production) ───────────────────────────────────────────────
# ≥ 32 random characters. Signs organizer sessions and applicants' private status links.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# Shared organizer password for /organizers (≥ 12 characters). Leave empty to disable sign-in.
ORGANIZER_PASSWORD=

# ── Optional: acknowledgment emails via Resend (https://resend.com) ────────────────
# When set, applicants get a "we received your application" email after it is saved.
# Acceptance/selection emails are never sent automatically.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# ── Preview-only content (ignored on Vercel production deploys) ────────────────────
# Fictional demo events/mentors, clearly labeled DEMO. For design work and tests.
SHOW_DEMO_CONTENT=false
# Show unapproved mentor copy, labeled DRAFT.
SHOW_DRAFT_CONTENT=false
